[[0.3,"Восьмеричная и шестнадцатеричная системы"],[4.45,"В восьмеричной системе основание 8 и цифры 0–7."],[8.91,"Шестнадцатеричные цифры: 0–9, A–F (A = 10 … F = 15)"],[13.69,"1 восьмеричная цифра = 3 бита"],[16.71,"1 шестнадцатеричная цифра = 4 бита"],[20.13,"Группы битов разбивают справа налево"],[24.71,"Пример."],[26.31,"Переведём 110101₂ в восьмеричную: 110 | 101 → 6 и 5, получаем 65₈."],[32.29,"В десятичной системе: 6·8 + 5 = 53."],[35.79,"Проверка по двоичной записи: 32 + 16 + 4 + 1 = 53."],[41.49,"Запомни."],[43.09,"Если в левой группе не хватает битов, дополни её нулями слева: 11 превращается в 011 или 0011."]]