[[0.3,"Единицы измерения информации"],[3.49,"Наименьшая единица информации — бит."],[7.07,"1 байт = 8 битов"],[9.05,"1 Кбайт = 1024 байта"],[11.35,"1 Мбайт = 1024 Кбайт, 1 Гбайт = 1024 Мбайт"],[15.41,"В меньшие единицы — умножаем, в большие — делим"],[20.87,"Пример."],[22.47,"Переведём 3 Кбайт в биты."],[25.17,"3 · 1024 = 3072 байта; 3072 · 8 = 24576 битов."],[29.55,"Проверка обратным действием: 24576 : 8 = 3072; 3072 : 1024 = 3."],[35.29,"Запомни."],[36.89,"Ориентир: путь из Кбайтов в биты — два умножения (на 1024 и на 8), из битов в Кбайты — два деления."]]